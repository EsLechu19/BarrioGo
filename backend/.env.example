# HTTPS public URL of this backend (required for Mercado Pago return URLs).
PUBLIC_BACKEND_URL=https://your-sandbox-backend.example.com

# Mercado Pago sandbox credentials; never place these in the app environment.
MP_ACCESS_TOKEN_TEST=TEST-access-token-here
# Required external setup: configure the test-mode Webhook URL in Mercado Pago
# as https://your-sandbox-backend.example.com/api/webhooks/mercadopago and
# subscribe to the Orders v2 topic. The API request does not send notification_url.
MP_WEBHOOK_SECRET=test-webhook-secret

# Firebase Admin service-account fields. Use a private server secret store.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-administrator@tu-proyecto.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-server-secret\n-----END PRIVATE KEY-----\n"

# Server
PORT=4000
