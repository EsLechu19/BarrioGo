{
  "expo": {
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "BarrioGo accede a tus fotos para la imagen de tu negocio, tus platos y tu perfil.",
          "cameraPermission": "BarrioGo usa la cámara para tomar fotos de tu negocio, tus platos y tu perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/img/noti-silueta.png",
          "color": "#F97316",
          "defaultChannel": "barriogo-pedidos-v2",
          "sounds": [
            "./assets/sounds/xd.wav"
          ]
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "name": "BarrioGo",
    "slug": "barriogov2",
    "scheme": "barriogo",
    "version": "3.2.0",
    "orientation": "portrait",
    "icon": "./assets/img/icon1.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BarrioGo usa tu ubicación para mostrarte los negocios más cercanos."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F97316",
        "foregroundImage": "./assets/img/icon1.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jotah26.BarrioGo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c2d3efe3-3831-444d-a5d6-9dcb9a4580ac"
      }
    },
    "owner": "jotah99"
  }
}
