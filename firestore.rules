rules_version = '2';
// Pegar en consola Firebase → Firestore → Reglas → Publicar.
// Lectura pública del catálogo; escritura solo vía Admin SDK (seed) o
// panel negocio (F4). Pedidos: solo autenticados (se refina en F4).
service cloud.firestore {
  match /databases/{database}/documents {
    match /negocios/{id} {
      allow read: if true;
      // S1: cualquier usuario logueado puede CREAR su negocio (el vínculo
      // dueño queda en dueñoId). Editar/borrar se cierra en S4 (solo dueño).
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /productos/{id} {
      allow read: if true;
      // F4/S1: alta de menú por usuarios logueados. S4 lo restringe al dueño.
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /pedidos/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
