rules_version = '2';
// Pegar en consola Firebase → Firestore → Reglas → Publicar.
// Lectura pública del catálogo; escritura solo vía Admin SDK (seed) o
// panel negocio (F4). Pedidos: solo autenticados (se refina en F4).
service cloud.firestore {
  match /databases/{database}/documents {
    match /negocios/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /productos/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /pedidos/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
