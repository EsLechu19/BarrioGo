rules_version = '2';
// Pegar en consola Firebase → Reglas → Publicar. Catálogo público;
// escritura solo del dueño. Los 15 del seed no tienen dueño.
service cloud.firestore {
  match /databases/{database}/documents {

    function esDuenoNegocio(negocioId) {
      return request.auth != null
        && get(/databases/$(database)/documents/negocios/$(negocioId)).data.duenioId == request.auth.uid;
    }

    match /negocios/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.duenioId == request.auth.uid;
    }
    match /productos/{id} {
      allow read: if true;
      allow create: if esDuenoNegocio(request.resource.data.negocioId);
      allow update: if esDuenoNegocio(resource.data.negocioId)
        && request.resource.data.negocioId == resource.data.negocioId;
      allow delete: if esDuenoNegocio(resource.data.negocioId);
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.rol == 'cliente'
        && !request.resource.data.keys().hasAny(['negocioId']);
      function esVinculacionNegocio() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rol', 'negocioId'
          ])
          && resource.data.rol == 'cliente'
          && request.resource.data.rol == 'negocio'
          && request.resource.data.negocioId is string
          && get(/databases/$(database)/documents/negocios/$(request.resource.data.negocioId)).data.duenioId == request.auth.uid;
      }
      // Dirección de trabajo: el dueño solo actualiza esa clave de su cuenta.
      function esUbicacionTrabajoPropia() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ubicacionTrabajo'
          ])
          && request.resource.data.ubicacionTrabajo is map
          && request.resource.data.ubicacionTrabajo.direccion is string
          && request.resource.data.ubicacionTrabajo.lat is number
          && request.resource.data.ubicacionTrabajo.lng is number
          && resource.data.rol == 'negocio'
          && resource.data.negocioId is string
          && get(/databases/$(database)/documents/negocios/$(resource.data.negocioId)).data.duenioId == request.auth.uid;
      }
      // La plantilla no puede cambiar rol ni negocioId; la excepción es
      // vincular un negocio creado por esta misma cuenta.
      // expoPushTokens = tokens de Expo Push. El nombre debe coincidir con
      // el que escribe la app (src/services/pushNotifications.ts).
      allow update: if request.auth != null
        && request.auth.uid == uid
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombre', 'email', 'telefono', 'preferencias', 'expoPushTokens'
          ])
          || esVinculacionNegocio()
          || esUbicacionTrabajoPropia()
        );
    }
    match /pedidos/{id} {
      function tieneCamposPedidoPermitidos() {
        return request.resource.data.keys().hasAll([
            'usuarioId', 'negocioId', 'items', 'total', 'estado', 'fecha'
          ])
          && request.resource.data.keys().hasOnly([
            'usuarioId', 'negocioId', 'items', 'total', 'estado', 'fecha',
            'direccion', 'metodoPago', 'clienteNombre', 'negocioNombre',
            'estadoPago', 'envio', 'pedidoGeneralId'
          ]);
      }

      function esDireccionPedidoValida(direccion) {
        return direccion is map
          && direccion.alias is string
          && direccion.alias.size() > 0
          && direccion.detalle is string
          && direccion.detalle.size() > 0;
      }

      function esMetodoPagoValido(metodoPago) {
        return metodoPago is map
          && metodoPago.tipo is string
          && metodoPago.tipo.size() > 0
          && metodoPago.nombre is string
          && metodoPago.nombre.size() > 0;
      }

      function esPedidoNuevoValido() {
        return request.auth != null
          && tieneCamposPedidoPermitidos()
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.negocioId is string
          && request.resource.data.negocioId.size() > 0
          && exists(/databases/$(database)/documents/negocios/$(request.resource.data.negocioId))
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.total is number
          && request.resource.data.total > 0
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.fecha is string
          && request.resource.data.fecha.size() > 0
          && (!('direccion' in request.resource.data)
            || esDireccionPedidoValida(request.resource.data.direccion))
          && (!('metodoPago' in request.resource.data)
            || esMetodoPagoValido(request.resource.data.metodoPago))
          && (!('clienteNombre' in request.resource.data)
            || (request.resource.data.clienteNombre is string
              && request.resource.data.clienteNombre.size() > 0))
          && (!('negocioNombre' in request.resource.data)
            || (request.resource.data.negocioNombre is string
              && request.resource.data.negocioNombre.size() > 0))
          && (!('envio' in request.resource.data)
            || (request.resource.data.envio is number
              && request.resource.data.envio >= 0))
          && (!('pedidoGeneralId' in request.resource.data)
            || request.resource.data.pedidoGeneralId is string)
          // estadoPago continúa simulado hasta integrar una pasarela: no
          // representa un cobro real ni sustituye la autorización del backend.
          && (!('estadoPago' in request.resource.data)
            || request.resource.data.estadoPago in ['pendiente', 'pagado', 'fallido'])
          // Mercado Pago state is server-owned: clients may only create a
          // sandbox order as pending, never pre-mark it paid or failed.
          && (!(('metodoPago' in request.resource.data)
              && request.resource.data.metodoPago.tipo == 'mercadopago_sandbox')
            || request.resource.data.estadoPago == 'pendiente');
      }

      function esTransicionValida() {
        return !('pagoActivoId' in resource.data)
          && (!(('metodoPago' in resource.data)
            && resource.data.metodoPago.tipo == 'mercadopago_sandbox')
            || resource.data.estadoPago == 'pagado')
          && ((resource.data.estado == 'pendiente'
            && request.resource.data.estado == 'confirmado')
          || (resource.data.estado == 'confirmado'
            && request.resource.data.estado == 'en_camino')
          || (resource.data.estado == 'en_camino'
            && request.resource.data.estado == 'entregado'));
      }

      function esCancelacionPropia() {
        return request.auth != null
          && resource.data.usuarioId == request.auth.uid
          && resource.data.estado == 'pendiente'
          && !('pagoActivoId' in resource.data)
          && request.resource.data.estado == 'cancelado'
          && request.resource.data.usuarioId == resource.data.usuarioId
          && request.resource.data.canceladoPor == request.auth.uid
          && request.resource.data.canceladoFecha is string;
      }

      function esRechazoNegocio() {
        return esDuenoNegocio(resource.data.negocioId)
          && resource.data.estado == 'pendiente'
          && !('pagoActivoId' in resource.data)
          && (!(('metodoPago' in resource.data)
            && resource.data.metodoPago.tipo == 'mercadopago_sandbox')
            || resource.data.estadoPago == 'pagado')
          && request.resource.data.estado == 'cancelado'
          && request.resource.data.usuarioId == resource.data.usuarioId
          && request.resource.data.negocioId == resource.data.negocioId
          && request.resource.data.canceladoPor == request.auth.uid
          && request.resource.data.canceladoFecha is string;
      }

      // Crear: identidad, forma, negocio existente e importes básicos.
      // Rules no puede iterar cada item contra el catálogo para recalcular el
      // total; esa garantía completa requiere backend/pasarela.
      allow create: if esPedidoNuevoValido();
      // Leer: el cliente ve los suyos, el dueño los de su negocio.
      allow read: if request.auth != null && (
        resource.data.usuarioId == request.auth.uid
        || esDuenoNegocio(resource.data.negocioId)
      );
      // Negocio: solo avanza un paso y solo cambia estado.
      allow update: if esDuenoNegocio(resource.data.negocioId)
        && esTransicionValida()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
      // El negocio solo puede rechazar pedidos pendientes antes de aceptarlos.
      allow update: if request.auth != null
        && esRechazoNegocio()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'canceladoPor', 'canceladoFecha'
        ]);
      // Cliente: solo puede cancelar su propio pedido pendiente.
      allow update: if esCancelacionPropia()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'canceladoPor', 'canceladoFecha'
        ]);
      // Fase 3: el cliente dueño actualiza únicamente el estado del pago
      // simulado (pendiente/pagado/fallido). No toca estado ni cancelación.
      allow update: if request.auth != null
        && resource.data.usuarioId == request.auth.uid
        && (!('metodoPago' in resource.data)
          || resource.data.metodoPago.tipo != 'mercadopago_sandbox')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estadoPago'
        ])
        && request.resource.data.estadoPago in ['pendiente', 'pagado', 'fallido'];
      allow delete: if false;
    }

    // Aggregate Mercado Pago payment records are created and updated only by
    // the trusted backend (Firebase Admin bypasses client security rules).
    match /pagos/{id} {
      allow read: if request.auth != null
        && resource.data.usuarioId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Pedido general multinegocio: solo lo crea y lee su dueño; inmutable
    // después (los estados viven en los subpedidos de `pedidos`).
    match /pedidosGenerales/{id} {
      allow read: if request.auth != null
        && resource.data.usuarioId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.subpedidoIds is list
        && request.resource.data.fecha is string;
      allow update, delete: if false;
    }

    // Fase 5: repartidores del negocio (sección Repartidores del panel).
    // Solo el dueño los crea/modifica/borra; el cliente no usa esta colección.
    match /repartidores/{id} {
      // El listener consulta con where('negocioId', '==', ...): Firestore
      // puede probar esa restricción de igualdad → solo el dueño lo lee.
      allow read: if esDuenoNegocio(resource.data.negocioId);

      allow create: if esDuenoNegocio(request.resource.data.negocioId)
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3
        && request.resource.data.estado in ['disponible', 'en_ruta', 'descanso']
        && request.resource.data.entregasHoy is number
        && request.resource.data.entregasHoy >= 0
        && ('telefono' in request.resource.data
            ? request.resource.data.telefono is string : true);

      // La app solo cambia `estado`; se habilita también `entregasHoy` para
      // no tener que volver a tocar reglas si se empieza a contar entregas.
      allow update: if esDuenoNegocio(resource.data.negocioId)
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'entregasHoy'])
        && request.resource.data.estado in ['disponible', 'en_ruta', 'descanso'];

      allow delete: if esDuenoNegocio(resource.data.negocioId);
    }

    // Reseñas: cada quien crea la suya, no se editan ni borran. Lectura
    // pública porque el rating se ve en Inicio sin sesión.
    match /opiniones/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.negocioId is string
        && request.resource.data.negocioId.size() > 0
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.estrellas is number
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 280
        && request.resource.data.fecha is string;
      allow update, delete: if false;
    }
  }
}
