# Copiar a .env (ESTE archivo sí se commitea, el .env NO).
# Valores: consola Firebase → Configuración del proyecto → Tus apps (web </>).
EXPO_PUBLIC_FB_API_KEY=tu_api_key
EXPO_PUBLIC_FB_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
EXPO_PUBLIC_FB_PROJECT_ID=tu_proyecto
EXPO_PUBLIC_FB_STORAGE_BUCKET=tu_proyecto.appspot.com
EXPO_PUBLIC_FB_SENDER_ID=tu_sender_id
EXPO_PUBLIC_FB_APP_ID=tu_app_id
